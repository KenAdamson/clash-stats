# --- Clash Royale API -------------------------------------------------------
# Key from developer.clashroyale.com. NOTE: keys are IP-WHITELISTED — if your
# WAN address changes (router/modem re-negotiation), every call fails with
# 403 accessDenied.invalidIp and ALL ingest stops until the key is re-issued.
# Whitelist a CIDR RANGE (e.g. 98.232.126.0/24), not a single address, so a
# DHCP lease change doesn't take the pipeline down. The 403 body names the
# rejected IP, which makes diagnosis immediate.
CR_API_KEY=your-api-key-from-developer.clashroyale.com
CR_PLAYER_TAG=L90009GPP
# CR_ALT_TAG=your-alt-tag

# Do NOT use proxy.royaleapi.dev — it is Cloudflare-blocked (error 1010).
# The official API is the default; this is only an escape hatch.
# CR_API_URL=https://api.clashroyale.com/v1

# --- Postgres ---------------------------------------------------------------
DB_PASSWORD=change-me

# --- RoyaleAPI replay scraping ----------------------------------------------
# Scraping needs BOTH cookies in the session file: cf_clearance (Cloudflare,
# short trust window) and __royaleapi_session_v2 (Discord login, ~7d sliding).
ROYALEAPI_SESSION_PATH=/app/data/royaleapi_session.json
ROYALEAPI_REQUESTS_PER_SEC=10.0
CORPUS_REPLAY_RATE=1.0

# Egress for personal/alt replays: the VPN sidecar.
ROYALEAPI_PROXY=http://cr-scraper-vpn:8888
FLARESOLVERR_URL=http://cr-scraper-vpn:8191/v1

# WARNING: GLUETUN_CONTROL_URL DEFAULTS TO http://cr-scraper-vpn:8000 IN CODE
# when unset — a job that merely omits it still takes the VPN-rotation path on
# a 403, rotating the SHARED exit and invalidating other jobs' cf_clearance.
# Always set it explicitly; use "" on any direct-egress path.
GLUETUN_CONTROL_URL=http://cr-scraper-vpn:8000

# --- Corpus replay egress ---------------------------------------------------
# 1 = corpus replays bypass the VPN and egress from the host's own IP; 0 = VPN.
# Direct is preferred while the residential IP is unbanned (the 2026-06 ban was
# pinned to the OLD address and did not follow the router cutover): the shared
# VPN exit is heavily Cloudflare-challenged, while direct returns clean 200s.
# Personal/alt deliberately STAY on the VPN, so a re-ban costs corpus
# throughput (recoverable) rather than personal battle history (not).
# cf_clearance is bound to the egress IP, so the direct path needs its OWN
# session file or the two paths invalidate each other's cookie.
CORPUS_REPLAY_DIRECT=1
DIRECT_SESSION_PATH=/app/data/royaleapi_session_direct.json
DIRECT_FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Proactive cf_clearance re-mint threshold (seconds). Reactive re-mint on a 403
# handles trust windows that close earlier than this.
# CF_CLEARANCE_MAX_AGE=1800
